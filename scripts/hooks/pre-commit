#!/bin/sh
# Blocks commits that introduce secret-shaped strings. Enable with:
#   git config core.hooksPath scripts/hooks
# Requires gitleaks (brew install gitleaks); skips with a warning if absent.

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed; skipping secret scan (brew install gitleaks)" >&2
    exit 0
fi

exec gitleaks protect --staged --redact --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
